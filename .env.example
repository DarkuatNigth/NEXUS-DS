# NEXUS-DS environment variables — copia este archivo a .env y ajusta si es necesario.
# En este proyecto todos los valores son dummy (entorno local con Floci).

FLOCI_PORT=4566
API_PORT=8000
UI_PORT=8501
AWS_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=nexus-ds-bucket
S3_DATASET_KEY=raw/Telco_customer_churn.xlsx
S3_MODEL_KEY=models/pipeline.joblib
SSM_METRICS_PATH=/nexus-ds/metrics/latest
